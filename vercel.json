{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/app.js": {
      "includeFiles": "app/**"
    },
    "api/claude.js": {
      "maxDuration": 300
    },
    "api/carga.js": {
      "maxDuration": 300
    },
    "api/pjn.py": {
      "maxDuration": 240,
      "includeFiles": "pjnlib/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/app"
    },
    {
      "source": "/_blob/:id",
      "destination": "/api/blob?id=:id"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
